{
  "swagger": "2.0",
  "info": {
    "title": "Movies & Reviews API",
    "description": "CSE341 Web Services API for managing movies and reviews with MongoDB and OAuth authentication",
    "version": "2.0.0"
  },
  "host": "movies-api-j8pw.onrender.com",
  "basePath": "/",
  "tags": [
    {
      "name": "Home",
      "description": "Root endpoint and status"
    },
    {
      "name": "Authentication",
      "description": "OAuth 2.0 and local bcrypt account endpoints"
    },
    {
      "name": "Movies",
      "description": "Operations on the movies collection (Protected write/update/delete)"
    },
    {
      "name": "Reviews",
      "description": "Operations on the reviews collection (Protected write/update/delete)"
    }
  ],
  "schemes": [
    "https",
    "http"
  ],
  "securityDefinitions": {
    "cookieAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Cookie",
      "description": "Connect.sid session cookie obtained by authenticating via /login or /auth/login"
    }
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Home"
        ],
        "description": "API root endpoint displaying login status and quick links",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/login": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "description": "Initiate GitHub OAuth 2.0 login flow",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "302": {
            "description": "Redirect to GitHub login"
          },
          "503": {
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/github/callback": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "description": "GitHub OAuth callback URL",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "302": {
            "description": "Redirect to homepage upon successful authentication"
          }
        }
      }
    },
    "/logout": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "description": "Log out current session and redirect home",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          },
          {
            "name": "redirect",
            "in": "query",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "302": {
            "description": "Redirected to home after session destroy"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "description": "Register a new account (passwords hashed with bcrypt)",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "User registration credentials",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RegisterUser"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "201": {
            "description": "Account registered successfully"
          },
          "400": {
            "description": "Validation failed"
          },
          "409": {
            "description": "User already exists"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "description": "Log in with local credentials (bcrypt verification)",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Login credentials",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LoginUser"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully authenticated"
          },
          "400": {
            "description": "Missing credentials"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "description": "Log out current API session",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully logged out"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/auth/status": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "description": "Check if a user is currently authenticated",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Current authentication status returned"
          }
        }
      }
    },
    "/auth/profile": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "description": "View protected user profile (only accessible when logged in)",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Profile details returned"
          },
          "401": {
            "description": "Unauthorized - Login required"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
    "/movies/": {
      "get": {
        "tags": [
          "Movies"
        ],
        "description": "Retrieve all movies from the database (Public)",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved all movies"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "tags": [
          "Movies"
        ],
        "description": "Create a new movie document with 9 required attributes (Requires authentication)",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Movie payload",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Movie"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "201": {
            "description": "Movie created successfully"
          },
          "400": {
            "description": "Validation failed or missing required fields"
          },
          "401": {
            "description": "Unauthorized - Login required"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
    "/movies/{id}": {
      "get": {
        "tags": [
          "Movies"
        ],
        "description": "Retrieve a single movie by its MongoDB ObjectId (Public)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Movie ObjectId (24 hex characters)"
          },
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the movie"
          },
          "400": {
            "description": "Invalid movie ID format"
          },
          "404": {
            "description": "Movie not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "tags": [
          "Movies"
        ],
        "description": "Update an existing movie document by its MongoDB ObjectId (Requires authentication)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Movie ObjectId (24 hex characters)"
          },
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated movie payload",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Movie"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "204": {
            "description": "Movie updated successfully"
          },
          "400": {
            "description": "Validation failed or invalid ID format"
          },
          "401": {
            "description": "Unauthorized - Login required"
          },
          "404": {
            "description": "Movie not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Movies"
        ],
        "description": "Delete a movie document by its MongoDB ObjectId (Requires authentication)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Movie ObjectId (24 hex characters)"
          },
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Movie deleted successfully"
          },
          "400": {
            "description": "Invalid movie ID format"
          },
          "401": {
            "description": "Unauthorized - Login required"
          },
          "404": {
            "description": "Movie not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
    "/reviews/": {
      "get": {
        "tags": [
          "Reviews"
        ],
        "description": "Retrieve all reviews from the database (Public)",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved all reviews"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "tags": [
          "Reviews"
        ],
        "description": "Create a new movie review (Requires authentication)",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Review payload",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Review"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "201": {
            "description": "Review created successfully"
          },
          "400": {
            "description": "Validation failed or missing required fields"
          },
          "401": {
            "description": "Unauthorized - Login required"
          },
          "404": {
            "description": "Referenced movie not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
    "/reviews/user/my-reviews": {
      "get": {
        "tags": [
          "Reviews"
        ],
        "description": "Retrieve reviews created by currently logged-in user (Requires authentication)",
        "parameters": [
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved user reviews"
          },
          "401": {
            "description": "Unauthorized - Login required"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
    "/reviews/{id}": {
      "get": {
        "tags": [
          "Reviews"
        ],
        "description": "Retrieve a single review by its MongoDB ObjectId (Public)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Review ObjectId (24 hex characters)"
          },
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the review"
          },
          "400": {
            "description": "Invalid review ID format"
          },
          "404": {
            "description": "Review not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "tags": [
          "Reviews"
        ],
        "description": "Update an existing review by its MongoDB ObjectId (Requires authentication)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Review ObjectId (24 hex characters)"
          },
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated review payload",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Review"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "204": {
            "description": "Review updated successfully"
          },
          "400": {
            "description": "Validation failed or invalid ID format"
          },
          "401": {
            "description": "Unauthorized - Login required"
          },
          "404": {
            "description": "Review not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Reviews"
        ],
        "description": "Delete a review by its MongoDB ObjectId (Requires authentication)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Review ObjectId (24 hex characters)"
          },
          {
            "name": "origin",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Review deleted successfully"
          },
          "400": {
            "description": "Invalid review ID format"
          },
          "401": {
            "description": "Unauthorized - Login required"
          },
          "404": {
            "description": "Review not found"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    }
  },
  "definitions": {
    "RegisterUser": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "example": "moviebuff"
        },
        "email": {
          "type": "string",
          "example": "moviebuff@example.com"
        },
        "password": {
          "type": "string",
          "example": "securePassword123"
        }
      }
    },
    "LoginUser": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "moviebuff@example.com"
        },
        "password": {
          "type": "string",
          "example": "securePassword123"
        }
      }
    },
    "Movie": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "Inception"
        },
        "director": {
          "type": "string",
          "example": "Christopher Nolan"
        },
        "releaseYear": {
          "type": "number",
          "example": 2010
        },
        "genre": {
          "type": "string",
          "example": "Sci-Fi"
        },
        "rating": {
          "type": "number",
          "example": 8.8
        },
        "runtime": {
          "type": "number",
          "example": 148
        },
        "synopsis": {
          "type": "string",
          "example": "A thief who steals corporate secrets through the use of dream-sharing technology is given the inverse task of planting an idea into the mind of a C.E.O."
        },
        "language": {
          "type": "string",
          "example": "English"
        },
        "posterUrl": {
          "type": "string",
          "example": "https://m.media-amazon.com/images/M/MV5BMjAxMzY3NjcxNF5BMl5BanBnXkFtZTcwNTI5OTM0Mw@@._V1_.jpg"
        }
      }
    },
    "Review": {
      "type": "object",
      "properties": {
        "movieId": {
          "type": "string",
          "example": "651a2b3c4d5e6f7a8b9c0d1e"
        },
        "reviewerName": {
          "type": "string",
          "example": "Alex Johnson"
        },
        "rating": {
          "type": "number",
          "example": 9
        },
        "comment": {
          "type": "string",
          "example": "Mind-bending visual masterpiece with a brilliant Hans Zimmer score!"
        },
        "reviewDate": {
          "type": "string",
          "example": "2024-03-15"
        }
      }
    }
  }
}